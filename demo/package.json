{
  "name": "@devdigest/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Screencast recorder for the DevDigest web app \u2014 Playwright, real stack, real LLM run.",
  "scripts": {
    "setup": "playwright install chromium",
    "record": "tsx record.ts",
    "record:skills": "tsx record-skills.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "record:conventions": "tsx record-conventions.ts",
    "record:intent": "tsx record-intent.ts",
    "record:smart-diff": "tsx record-smart-diff.ts",
    "record:mcp": "tsx record-mcp.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
