node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# Course materials. Lecture slides and notes stay out of the repo (the L01 deck
# alone is 14 MB and would double .git). The design bundle is the exception: the
# client is ported from it — see the "Ported from screen_dashboard.jsx" comments
# — so it is tracked as the visual source of truth.
_assets/*
!_assets/DevDigest Design (standalone).html
