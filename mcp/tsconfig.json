{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "declaration": false,
    "sourceMap": true,
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "@devdigest/shared": ["../server/src/vendor/shared/index.ts"],
      "@devdigest/shared/*": ["../server/src/vendor/shared/*"],
      // Sub-path ONLY, never the barrel: reviewer-core/src/index.ts re-exports
      // OpenRouterProvider, which drags the `openai` SDK into this package's
      // dependency tree. `prompt.ts` imports one type from @devdigest/shared
      // plus the pure `./skills.js` and nothing else.
      "@devdigest/reviewer-core/*": ["../reviewer-core/src/*"],
      // Pin zod to THIS package's copy. Two zod instances in one process make
      // `instanceof z.ZodError` silently false — the failure server/src/app.ts
      // (the "robust ZodError detection" block) exists to work around.
      //
      // DELIBERATELY NO `"zod/*"` ENTRY, unlike reviewer-core's tsconfig. The
      // MCP SDK supports zod 3 and 4 side by side and imports `zod/v3` and
      // `zod/v4/core` from its own type declarations. A wildcard remap sends
      // those through `./node_modules/zod/*` and the resulting types blow up
      // as `TS2589: type instantiation is excessively deep` on every single
      // `registerTool` call — which reads like a bug in this package's schemas
      // and is not. Nothing here imports a zod sub-path, so the entry buys
      // nothing and costs that.
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
